{#
/**
 * @file
 * node--tourist-trip.html.twig
 *
 * TouristTrip node template.
 *
 * All data-shaping is handled in surface_preprocess_node__tourist_trip()
 * (includes/node.theme), which delegates to:
 *   - trail_mapper.article_geo_data->buildTrip()
 *   - seanmontague_map.article_map_data->buildTrip()
 *
 * Variables provided by preprocess:
 *   - trip_data: array matching @collections/trip/trip.twig contract.
 */
#}
{% set body = trip_data.body %}

{# 1 ─ Trip header (trip-specific: hero, title, dates, strip, stats) #}
{{ attach_library('surface/trip-header') }}
{% include '@collections/trip-header/trip-header.twig' with {
  'label':        trip_data.label,
  'title':        trip_data.title,
  'dates':        trip_data.dates,
  'image_url':    trip_data.image_url,
  'destinations': trip_data.destinations,
  'stats':        trip_data.stats,
} only %}

{# 2 ─ Map ONLY (no elevation profile) — the SAME collection the article uses,
       fed the aggregated tracks + markers from the itinerary. #}
{% include '@collections/map-section/map-section.twig' with {
  'map_id':              trip_data.map_id,
  'map_ratio':           trip_data.map_ratio,
  'map_center':          trip_data.map_center,
  'map_zoom':            trip_data.map_zoom,
  'tiles':               trip_data.tiles,
  'map_markers':         trip_data.map_markers,
  'map_lines':           null,
  'geojson_url':         trip_data.geojson_urls.0 ?? null,
  'geojson_urls':        trip_data.geojson_urls,
  'track_stats':         trip_data.track_stats,
  'drupal_geo_rendered': null,
  'show_elevation':      false,
  'fit':                 trip_data.map_fit,
} only %}

{# 3 ─ Body + itinerary aside — the SAME layout the article uses. #}
{{ attach_library('surface/itinerary') }}
{% embed '@layouts/content-aside/content-aside.twig' with {
  'main_modifier': main_modifier|default(''),
} %}
  {% block main %}
    {% if trip_data.narrative_heading %}
      <div class="trip__narrative-kicker">{{ trip_data.narrative_kicker }}</div>
      <h2 class="trip__narrative-heading">{{ trip_data.narrative_heading }}</h2>
    {% endif %}
    <div class="prose">{{ body }}</div>
  {% endblock %}
  {% block aside %}
    {% include '@components/itinerary/itinerary.twig' with {
      'items': trip_data.destinations,
    } only %}
  {% endblock %}
{% endembed %}

{# 4 ─ Destination cards (KEEP unless Sean drops them) #}
{% if trip_data.destinations is not empty %}
  {{ attach_library('surface/destination-cards') }}
  {% include '@components/destination-cards/destination-cards.twig' with {
    'items': trip_data.destinations,
  } only %}
{% endif %}
