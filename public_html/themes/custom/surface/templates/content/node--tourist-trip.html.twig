{#
/**
 * @file
 * node--tourist-trip.html.twig — renders a TouristTrip node's CONTENT.
 *
 * PURE MARKUP. Data is built in surface_preprocess_node__tourist_trip()
 * (includes/node.theme) → trip_data. Composed DIRECTLY here (node--article
 * model); @layouts/trip is the parallel Storybook composition, kept in sync.
 *
 * Trip-identity styling is applied via MODIFIERS on shared components/elements
 * (eyebrow--forest/--trip, title--trip, content-aside--trip) and lives in
 * trip.css. Attaching surface/trip loads trip.css AND every component's CSS via
 * its dependencies — one attach, fully styled.
 */
#}
{{ attach_library('surface/trip') }}

{% set body = content.body|field_value %}


{# 1 ─ Trip header: hero, title, dates, destinations strip, stats. #}
{% include '@collections/trip-header/trip-header.twig' with {
  'label':        trip_data.label,
  'title':        trip_data.title,
  'dates':        trip_data.dates,
  'image_url':    trip_data.image_url,
  'destinations': trip_data.destinations,
  'stats':        trip_data.stats,
} only %}

{# 2 ─ Trip map: all itinerary tracks + markers, labeled header band, no chart. #}
{% include '@collections/map-section/map-section.twig' with {
  'map_id':              trip_data.map_id,
  'map_ratio':           trip_data.map_ratio,
  'map_center':          trip_data.map_center,
  'map_zoom':            trip_data.map_zoom,
  'tiles':               trip_data.tiles,
  'map_markers':         trip_data.map_markers,
  'map_lines':           null,
  'geojson_url':         trip_data.geojson_urls.0 ?? null,
  'geojson_urls':        trip_data.geojson_urls,
  'track_stats':         trip_data.track_stats,
  'drupal_geo_rendered': null,
  'show_chart':          false,
  'fit':                 trip_data.map_fit,
} only %}


{# 3 ─ Body + itinerary aside (content-aside--trip restores the trip framing). #}
{% embed '@layouts/content-aside/content-aside.twig' with {
  'modifier':      'content-aside--trip',
  'main_modifier': main_modifier|default(''),
} %}
  {% block main %}
    {% if content.field_narrative_heading|field_value %}
      {% include '@elements/eyebrow/eyebrow.twig' with {
        'eyebrow': {
          'text':     content.field_narrative_kicker|field_value,
          'modifier': 'eyebrow--forest eyebrow--trip',
        },
      } only %}
      {% include '@elements/title/title.twig' with {
        'title': {
          'level':    2,
          'text':     content.field_narrative_heading|field_value,
          'modifier': 'title--trip',
        },
      } only %}
    {% endif %}
    <div class="prose">{{ body }}</div>
  {% endblock %}
  {% block aside %}
    {% include '@components/itinerary/itinerary.twig' with {
      'items': trip_data.itinerary,
    } only %}
  {% endblock %}
{% endembed %}

{% do ray(trip_data.destinations) %}
{# 4 ─ Destination cards. #}
{% if trip_data.destinations is not empty %}
  {% include '@components/destination-cards/destination-cards.twig' with {
    'items': trip_data.destinations,
  } only %}
{% endif %}
