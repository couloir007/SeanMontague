{#
/**
 * @file
 * Article node template — renders an article node's CONTENT.
 *
 * ╔══════════════════════════════════════════════════════════════════════════╗
 * ║ THIS TEMPLATE IS PURE MARKUP. It computes almost nothing.                ║
 * ║ All data is built upstream in the preprocess hook:                       ║
 * ║   includes/node.theme → surface_preprocess_node__article()               ║
 * ║     ├─ trail_mapper.article_geo_data ->build($node)   (geo/track/stats)  ║
 * ║     │    modules/custom/trail_mapper/src/Service/ArticleGeoData.php      ║
 * ║     └─ seanmontague_map.article_map_data ->build($node) (markers/config) ║
 * ║   The hook also computes the unified `has_map` and `article_header`.     ║
 * ║   See README-node--article.md for the full variable→source map.          ║
 * ╚══════════════════════════════════════════════════════════════════════════╝
 *
 * RENDERS CONTENT ONLY. page.html.twig owns the page shell (it extends
 * @layouts/site-container). This template must NOT extend site-container (that
 * nests the shell inside itself) and must NOT render the site nav (nav is page
 * chrome from the header region → site-header).
 *
 * ── Variables this template consumes (all from the hook unless noted) ──
 *   article_header   object: title/subtitle/date/category/category_key/
 *                    difficulty/stats/map_id     → article-header include
 *   stats            top stats bar (inside article_header)  [ArticleGeoData]
 *   map_id           '' when no map; 'article-map-<nid>' otherwise   [hook]
 *   map_center       fallback center (overridden by fitBounds)  [ArticleGeoData]
 *   map_zoom, tiles  base map config                  [ArticleMapData]
 *   map_markers      destination/POI/lodging pins      [ArticleMapData]
 *   geojson_url(s)   track file URL(s)                 [ArticleGeoData]
 *   track_stats      per-track stats (METERS)          [ArticleGeoData]
 *   map_lines, drupal_geo_rendered   null on the article path (the shared
 *                    map-section reads both)                         [hook]
 *   main_modifier    'content-aside__main--with-map' when has_map  [hook]
 *   body             content.body|field_value  ← THE ONE value set BELOW (Twig)
 *
 * ── What makes an article show a map (has_map, computed in the hook) ──
 *   has_geoshape (GeoJSON track media) OR has_geo (node geofield) OR
 *   has_place (referenced place) OR map_markers not empty.
 *   A marker-only article (no track/geo/place) STILL gets a map — intentional.
 *
 * ── Sidebar content is rendered by FIELD TEMPLATES, not built here ──
 *   {{ content.schema_geoshape }} → GPX download (field template/display)
 *   {{ content.schema_poi }}      → POI side-card
 *        templates/field/field--node--schema-poi--article.html.twig
 */
#}

{# `body` is the ONE value still set Twig-side — it is a render array
   (content.body|field_value), cleaner to resolve here than in the hook.
   Everything else comes from includes/node.theme (see header above). #}
{% set body = content.body|field_value %}


{# ──────────────────────────────────────────────────────────────────────────
   COMPONENT COMPOSITION  (rendered in this order)
   1. reading-progress  — scroll bar (element)
   2. article-header    — title/date/category/difficulty + stats (collection)
   3. map-section       — full-width map + elevation profile (collection)
                          NB: the ARTICLE route block, not homepage-map-section
   4. content-aside     — two-column body + sidebar shell (layout)
   Composed directly here (not delegated to @layouts/article). Content only —
   no site-container extend, no nav.
   ────────────────────────────────────────────────────────────────────────── #}

{# 1 ─ Reading progress bar #}
{% include '@elements/reading-progress/reading-progress.twig' %}

{# 2 ─ Article header: title, date, category, difficulty, stats bar.
       Built as the `article_header` object in the preprocess hook. #}
{% if article_header %}
  {% include '@collections/article-header/article-header.twig' with article_header only %}
{% endif %}

{# 3 ─ Article map + elevation section (full width).
       Renders a map only when map_id is set (has_map). All map data from the
       hook/services. The article map-section renders map + elevation only — no
       label/title (those were removed; that's the homepage promo block's job). #}
{% include '@collections/map-section/map-section.twig' with {
  'map_id':              map_id,
  'map_center':          map_center,
  'map_zoom':            map_zoom,
  'map_markers':         map_markers,
  'map_lines':           map_lines,
  'geojson_url':         geojson_url,
  'geojson_urls':        geojson_urls,
  'track_stats':         track_stats,
  'drupal_geo_rendered': drupal_geo_rendered,
  'tiles':               tiles,
} only %}


{# 4 ─ Body + sidebar: generic two-column shell (@layouts/content-aside).
       main  = the article prose body
       aside = field-rendered cards (GPX download + POI side-card) #}
{% embed '@layouts/content-aside/content-aside.twig' with {
  'main_modifier': main_modifier,
} %}
  {% block main %}
    {# Drop cap is opt-in: add class="drop-cap" to the first <p> in the body HTML. #}
    <div class="prose">{{ body }}</div>
  {% endblock %}
  {% block aside %}
    {# Sidebar cards come from FIELD TEMPLATES (not built in this node):
       schema_geoshape → GPX download; schema_poi → POI side-card. #}
    {{ content.schema_geoshape }}
    {{ content.schema_poi }}
  {% endblock %}
{% endembed %}
