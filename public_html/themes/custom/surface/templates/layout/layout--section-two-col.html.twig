{% if content %}
  {{ attach_library('surface/content-aside') }}
  <div{{ attributes.addClass('content-aside') }}>
    <div{{ region_attributes.main.addClass('content-aside__main') }}>
      {{ content.main }}
    </div>
    <aside{{ region_attributes.aside.addClass('content-aside__aside') }}>
      {{ content.aside }}
    </aside>
  </div>
{% endif %}
