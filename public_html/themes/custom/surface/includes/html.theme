<?php

/**
 * @file
 * HTML-related hook implementations.
 */

use Drupal\Core\Cache\CacheableMetadata;

/**
 * Implements theme_preprocess to add variables.
 */
function surface_preprocess(&$variables) {
  $variables['data_menu'] = 'dropdown';
}

/**
 * Implements hook_preprocess_HOOK() for maintenance-page.html.twig.
 */
function surface_preprocess_maintenance_page(&$variables) {
  // By default, site_name is set to Drupal if no db connection is available
  // or during site installation. Setting site_name to an empty string makes
  // the site and update pages look cleaner.
  // @see template_preprocess_maintenance_page
  if (!$variables['db_is_active']) {
    $variables['site_name'] = '';
  }

  // Surface has custom styling for the maintenance page.
  $variables['#attached']['library'][] = 'surface/maintenance-page';
}

/**
 * Implements hook_preprocess_HOOK() for region templates.
 */
function surface_preprocess_region(&$variables) {
  // Make is_front available in all region templates.
  $variables['is_front'] = \Drupal::service('path.matcher')->isFrontPage();

  // Header region: build the main-menu links for the nav component.
  if (($variables['region'] ?? '') === 'header') {
    $cache = new CacheableMetadata();
    $variables['main_menu_links'] = _surface_menu_links('main', $cache);
    // Bubble menu + per-link cacheability (route context for active trail,
    // config tag so the nav rebuilds when the menu changes).
    $cache->applyTo($variables['elements']);
  }
}

function surface_preprocess_field(&$variables): void {
  $rich_field_types = ['text_with_summary', 'text', 'text_long'];

  if (in_array($variables['field_type'], $rich_field_types, TRUE)) {
    $variables['attributes']['class'][] = 'prose';
  }
}

/**
 * Builds a flat {text, url, active} list from a menu's top level.
 *
 * Loads the menu via the menu tree — access-checked, sorted, active-trail
 * aware — so the nav reflects real menu config + permissions, unlike a
 * hardcoded list. Top level only (maxDepth 1); raise the depth and nest in the
 * template if dropdowns are ever needed.
 *
 * @param string $menu_name
 *   Menu machine name (e.g. 'main').
 * @param \Drupal\Core\Cache\CacheableMetadata $cache
 *   Collects menu + per-link cacheability for the caller to bubble.
 *
 * @return array
 *   List of ['text' => string, 'url' => string, 'active' => bool].
 */
function _surface_menu_links(string $menu_name, CacheableMetadata $cache): array {
  $menu_tree = \Drupal::menuTree();
  $parameters = $menu_tree->getCurrentRouteMenuTreeParameters($menu_name);
  $parameters->setMaxDepth(1);
  $parameters->onlyEnabledLinks();

  $tree = $menu_tree->load($menu_name, $parameters);
  $tree = $menu_tree->transform($tree, [
    ['callable' => 'menu.default_tree_manipulators:checkAccess'],
    ['callable' => 'menu.default_tree_manipulators:generateIndexAndSort'],
  ]);

  $links = [];
  foreach ($tree as $element) {
    // checkAccess set ->access on every element; respect and bubble it.
    $cache->addCacheableDependency($element->access);
    if (!$element->access->isAllowed()) {
      continue;
    }
    $generated = $element->link->getUrlObject()->toString(TRUE);
    $cache->addCacheableDependency($generated);
    $links[] = [
      'text'   => $element->link->getTitle(),
      'url'    => $generated->getGeneratedUrl(),
      'active' => $element->inActiveTrail,
    ];
  }

  $cache->addCacheContexts(['route']);
  $cache->addCacheTags(['config:system.menu.' . $menu_name]);
  return $links;
}
