{{ attach_library('surface/map-section') }}

<div class="map-section{{ map_modifier ? ' ' ~ map_modifier }}">
  <div class="map-section__map-container" style="--map-ratio: {{ map_ratio|default('3 / 2') }};">
    {% if drupal_geo_rendered %}
      {{ drupal_geo_rendered }}
    {% elseif map_id %}
      {% include '@components/map/map.twig' with {
        'map_id':       map_id,
        'center':       map_center,
        'zoom':         map_zoom|default(13),
        'interactive':  'true',
        'markers':      map_markers,
        'geojson_url':  geojson_url,
        'geojson_urls': geojson_urls,
        'track_stats':  track_stats,
        'tiles':        tiles|default('usgs-topo'),
        'fit':          fit|default('true'),
      }|merge(map_lines ? { 'lines': map_lines } : {}) only %}
    {% endif %}
  </div>

  {% if show_chart|default(true) and (elev_gain or geojson_url) %}
    <div class="map-section__elevation-container">
      {% include '@components/elevation-profile/elevation-profile.twig' with {
        'gain':        elev_gain,
        'loss':        elev_loss,
        'min_elev':    elev_min,
        'max_elev':    elev_max,
        'elev_data':   elev_data,
        'geojson_url': geojson_url,
        'canvas_id':   (map_id|default('article-map')) ~ '-elevation',
        'map_id':      map_id|default('article-map'),
        'show_chart':  show_chart,
      } only %}
    </div>
  {% endif %}
</div>
