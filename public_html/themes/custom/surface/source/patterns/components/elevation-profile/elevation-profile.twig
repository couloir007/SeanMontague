{{ attach_library('surface/elevation-profile') }}

<div class="elevation-profile{{ modifier ? ' ' ~ modifier }}"
     {% if map_id %}data-map-id="{{ map_id }}"{% endif %}
     {% if geojson_url %}data-geojson-url="{{ geojson_url }}"{% endif %}
     {% if elev_data %}data-elev='{{ elev_data|json_encode }}'{% endif %}>
  {# Label ("{name} Stats") and stats chips are filled by elevation-profile.js
     from the selected track's stored media stats (display-only, unit-converted).
     The canvas is hidden by JS for tracks with no real elevation. #}
  <div class="elevation-profile__header">
    <span class="elevation-profile__header-label">Elevation Profile</span>
    <div class="elevation-profile__header-stats"></div>
  </div>
  {# Chart is opt-out: trips pass show_chart=false to keep the per-track stats
     header under the map but drop the graph. JS no-ops the chart when the
     canvas is absent (it guards on !canvas) and still fills the stats. #}
  {% if show_chart == true %}
    <canvas class="elevation-profile__canvas" id="{{ canvas_id|default('elevation-chart') }}"></canvas>
    <div class="elevation-profile__tooltip" id="{{ tooltip_id|default('elev-tooltip') }}"></div>
  {% endif %}
</div>
