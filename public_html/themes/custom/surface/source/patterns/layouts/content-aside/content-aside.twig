{{ attach_library('surface/content-aside') }}

<div class="content-aside{{ modifier ? ' ' ~ modifier }}">
  <div class="content-aside__main{{ main_modifier ? ' ' ~ main_modifier }}">
    {% block main %}{{ main|raw }}{% endblock %}
  </div>
  <aside class="content-aside__aside">
    {% block aside %}{{ aside|raw }}{% endblock %}
  </aside>
</div>
