<?php

/**
 * @file
 * Installation hooks for the Schema.org Blueprints Additional Type module.
 */

declare(strict_types=1);

/**
 * Implements hook_install().
 */
function schemadotorg_additional_type_install(bool $is_syncing): void {
  if ($is_syncing) {
    return;
  }

  // Setting weight to 1 so that the Schema.org Additional Type
  // hooks are triggered after the Navigation module.
  module_set_weight('schemadotorg_additional_type', 1);
}

/**
 * Issue #3460229: Add the ability to require additional type before displaying the node edit form.
 */
function schemadotorg_additional_type_update_10000(): void {
  \Drupal::configFactory()
    ->getEditable('schemadotorg_additional_type.settings')
    ->set('required_types', ['Event'])
    ->save();
}

/**
 * Issue #3461525: Use snake case for additional type values.
 */
function schemadotorg_additional_type_update_10001(): void {
  \Drupal::configFactory()
    ->getEditable('schemadotorg_additional_type.settings')
    ->set('use_snake_case', TRUE)
    ->save();
}

/**
 * Issue #3527491: Schema.org Additional Type content create dialog not working with core navigation links.
 */
function schemadotorg_additional_type_update_10002(): void {
  // Setting weight to 1 so that the Schema.org Additional Type
  // hooks are triggered after the Navigation module.
  module_set_weight('schemadotorg_additional_type', 1);
}

/**
 * Issue #3540563: Allow certain additional types to be ignored.
 */
function schemadotorg_additional_type_update_10003(): void {
  \Drupal::configFactory()
    ->getEditable('schemadotorg_additional_type.settings')
    ->set('ignored_types', ['Default', 'default', 'Other', 'other'])
    ->save();
}

/**
 * Issue #3548302: Improve additional type JSON-LD handling.
 */
function schemadotorg_additional_type_update_10004(): void {
  \Drupal::configFactory()
    ->getEditable('schemadotorg_additional_type.settings')
    ->set('jsonld_values', [])
    ->save();
}

/**
 * Issue #3554079: Set default values for entity additional types.
 */
function schemadotorg_additional_type_update_10005(): void {
  \Drupal::configFactory()
    ->getEditable('schemadotorg_additional_type.settings')
    ->set('default_field_values', [])
    ->save();
}

/**
 * Issue #3560449: Add support to manage field access based on additional types.
 */
function schemadotorg_additional_type_update_10006(): void {
  \Drupal::configFactory()
    ->getEditable('schemadotorg_additional_type.settings')
    ->set('field_access', [])
    ->save();
}

/**
 * Issue #3582293: Add optional derived node base fields for additional types.
 */
function schemadotorg_additional_type_update_10007(): void {
  \Drupal::configFactory()
    ->getEditable('schemadotorg_additional_type.settings')
    ->set('create_base_fields', [])
    ->save();
}

/**
 * Issue #3583306: Change full type derived values to use double dashes.
 */
function schemadotorg_additional_type_update_10008(): void {
  $database = \Drupal::database();
  $schema = $database->schema();
  $entity_type_manager = \Drupal::entityTypeManager();
  $entity_type_ids = \Drupal::config('schemadotorg_additional_type.settings')
    ->get('create_base_fields') ?? [];

  foreach ($entity_type_ids as $entity_type_id) {
    $entity_type = $entity_type_manager->getDefinition($entity_type_id);
    $data_table = $entity_type->getDataTable() ?: $entity_type->getBaseTable();
    $tables = $data_table ? [$data_table] : [];

    if ($entity_type->isRevisionable()) {
      $revision_table = $entity_type->getRevisionDataTable() ?: $entity_type->getRevisionTable();
      if ($revision_table) {
        $tables[] = $revision_table;
      }
    }

    foreach ($tables as $table) {
      if (!$schema->fieldExists($table, 'schemadotorg_full_type')) {
        continue;
      }

      $database->update($table)
        ->expression(
          'schemadotorg_full_type',
          'REPLACE(schemadotorg_full_type, :search, :replace)',
          [':search' => ':', ':replace' => '--'],
        )
        ->isNotNull('schemadotorg_full_type')
        ->condition('schemadotorg_full_type', '%:%', 'LIKE')
        ->execute();
    }
  }
}
