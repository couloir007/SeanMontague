{
    "name": "drupal/search_api_opensolr",
    "description": "Extends the drupal search_api_solr module by providing integration with opensolr 3rd party service.",
    "type": "drupal-module",
    "keywords": [
        "Drupal",
        "Search API",
        "Solr",
        "opensolr"
    ],
    "homepage": "https://www.drupal.org/project/search_api_opensolr",
    "authors": [
        {
            "name": "Cristina (bbu23)",
            "homepage": "https://www.drupal.org/u/bbu23"
        },
        {
            "name": "Ciprian Dimofte (opensolr)",
            "homepage": "https://www.drupal.org/u/opensolr"
        },
        {
            "name": "See other contributors",
            "homepage":"https://www.drupal.org/node/3065925/committers"
        }
    ],
    "support": {
        "issues": "https://www.drupal.org/project/issues/search_api_opensolr",
        "irc": "irc://irc.freenode.org/drupal-search-api-opensolr",
        "source": "http://git.drupal.org/project/search_api_opensolr.git"
    },
    "license": "GPL-2.0+",
    "require": {
        "php": ">=8.1",
        "drupal/search_api_solr": ">=4.3.2",
        "ext-zip": "*"
    },
    "require-dev": {
      "drupal/key": "^1.0"
    },
    "suggest": {
        "drupal/key": "Manages sensitive keys."
    },
    "extra": {
        "drush": {
            "services": {
                "drush.services.yml": ">=9"
            }
        }
    }
}
